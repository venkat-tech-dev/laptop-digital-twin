# ---------------------------------------------------------------------------
# Laptop Digital Twin - configuration
# Copy to .env (never commit .env). Values here are safe local-development defaults.
# ---------------------------------------------------------------------------

# development | test | production   (production enforces auth + strong keys)
APP_ENV=development
LOG_LEVEL=INFO

# Backend bind address. Keep 127.0.0.1 so the API is not exposed on your network.
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL / TimescaleDB (docker compose publishes it on 127.0.0.1:${POSTGRES_HOST_PORT}).
# Non-default host ports avoid clashing with a locally installed PostgreSQL/Redis.
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
FRONTEND_HOST_PORT=8088
# Leave empty to run without persistence (history kept in memory only).
POSTGRES_USER=ldt
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ldt
DATABASE_URL=postgresql+asyncpg://ldt:change-me-local-only@127.0.0.1:15432/ldt

# Redis (hot twin state, pub/sub fan-out, short-term buffer). Leave empty to disable.
REDIS_URL=redis://127.0.0.1:16379/0

# Browser origins allowed to call the API / open the WebSocket (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088

# --- Security ---------------------------------------------------------------
# AUTH_MODE: none (local development only) | api_key | jwt | accounts
#   accounts = user accounts with roles (admin / operator / viewer). The first visit shows a
#   "create administrator" screen. Requires JWT_SECRET (>= 32 chars).
AUTH_MODE=none
# Comma-separated API keys for the UI / API clients (required unless AUTH_MODE=none).
API_KEYS=
# HS256 secret for JWTs (>= 32 chars) when AUTH_MODE=jwt or accounts.
JWT_SECRET=
# Optional one-time token required to create the first administrator (AUTH_MODE=accounts).
SETUP_TOKEN=
JWT_TTL_MINUTES=60

# ---- Phase 9: organizations, identity, governance (docs/operations/enterprise-admin.md) ----------
# Previous JWT secrets still accepted during rotation (comma separated); remove after one session lifetime.
JWT_SECRET_PREVIOUS=
# Fernet key encrypting MFA (TOTP) seeds. Without it MFA cannot be enrolled. Back it up separately. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# Directory with one file per secret (Docker / Kubernetes secrets); overrides the variables above.
SECRETS_DIR=
# Devices may still register with the shared AGENT_INGEST_KEY (default organization). Set false once
# every device enrolls with an organization enrollment token.
ALLOW_LEGACY_ENROLLMENT=true
# External URL of the console/API behind TLS (OIDC redirect URIs); HSTS only when served over HTTPS.
PUBLIC_BASE_URL=
HSTS_ENABLED=false
# Identity integrations (SAML exposes metadata only; assertions are refused until a validator exists).
FEATURE_OIDC=true
FEATURE_SAML=true
FEATURE_SCIM=true
OIDC_ALLOW_HTTP=false
# Shared secret between the host agent and the backend ingest API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_INGEST_KEY=replace-with-a-random-32-char-secret
RATE_LIMIT_PER_MINUTE=600

# --- Telemetry agent (runs on the Windows host) ------------------------------
AGENT_BACKEND_URL=http://127.0.0.1:8000
TELEMETRY_INTERVAL_MS=1000
# CPU_INTERVAL_MS=500
BATTERY_INTERVAL_MS=5000
PROCESS_INTERVAL_MS=3000
PUBLISH_INTERVAL_MS=1000
# auto (LibreHardwareMonitor if running + ACPI thermal zones) | lhm | acpi | none
HARDWARE_SENSOR_PROVIDER=auto
LHM_URL=http://127.0.0.1:8085/data.json
TOP_PROCESS_COUNT=15
AGENT_CPU_BUDGET_PERCENT=3.0
INCLUDE_SERIAL_NUMBERS=false
INCLUDE_MAC_ADDRESSES=false

# --- Twin / persistence -------------------------------------------------------
TWIN_DEGRADED_AFTER_S=3
TWIN_STALE_AFTER_S=10
TWIN_OFFLINE_AFTER_S=30
PERSIST_SAMPLE_INTERVAL_S=5
RETENTION_DAYS=30
EXPOSE_SERIAL_NUMBERS=false

# Optional OpenTelemetry tracing (requires: pip install -e "backend[otel]")
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Outbound sync (off by default) ------------------------------------------
# Ingest key of another Laptop Digital Twin backend ("hub"). The target URL and the on/off switch are
# set by an administrator in Settings. Nothing leaves this machine unless all three are set.
SYNC_TARGET_KEY=

# --- Agent extras -------------------------------------------------------------
# Opt-in: image path (profile name redacted), owner and publisher of the listed top processes.
# Administrators can also change this (and the telemetry interval) from Settings at runtime.
COLLECT_PROCESS_DETAILS=false
# NVMe SMART health, Secure Boot / TPM and WHEA event scan cadence.
RELIABILITY_INTERVAL_MS=30000
# How often the agent polls the backend for operator configuration (0 = never).
CONFIG_POLL_INTERVAL_S=15

# --- Endpoint agent (Phase 1) -------------------------------------------------
# Full list and defaults: docs/endpoint-agent.md. The agent exchanges AGENT_INGEST_KEY for a per-device
# token at first start (stored DPAPI-encrypted in the agent data directory).
# AGENT_ID=
# AGENT_CA_BUNDLE=                      # custom CA bundle for a corporate HTTPS backend
# AGENT_ALLOW_INSECURE_LOCALHOST=true   # plain http only for a loopback backend
# NETWORK_HEALTH_INTERVAL_MS=30000
# SECURITY_INTERVAL_MS=300000
# SERVICES_INTERVAL_MS=60000
# EVENTLOG_INTERVAL_MS=60000
# UPDATES_INTERVAL_MS=1800000
# OFFLINE_FLUSH_INTERVAL_S=30
# BATCH_SIZE=50
# QUEUE_MAX_BATCHES=20000
# QUEUE_MAX_MB=200
# QUEUE_MAX_AGE_H=72
# SYNC_MAX_ATTEMPTS=5
# SYNC_BACKOFF_MAX_S=60
# ENABLE_SECURITY_COLLECTION=true
# ENABLE_UPDATE_COLLECTION=true
# ENABLE_EVENTLOG_COLLECTION=true
# SERVICE_ALLOWLIST=WinDefend,mpssvc,wuauserv,BITS,EventLog,Dhcp,Dnscache,WlanSvc,LanmanWorkstation,W32Time,SecurityHealthService
# LATENCY_PROBE_HOST=                   # empty = gateway only (no traffic beyond the LAN)
# INCLUDE_HOSTNAME=true
# INCLUDE_IP_ADDRESSES=false
# AGENT_LOG_MAX_MB=5
# AGENT_LOG_BACKUPS=5

# --- Telemetry pipeline (Phase 2) ---------------------------------------------
# Full description: docs/telemetry-pipeline.md
# Backend
# ALLOW_ENROLLMENT_KEY_INGEST=false     # ingest needs the per-device token (enrollment key = register only)
# INGEST_RATE_PER_DEVICE_PER_MIN=240
# INGEST_RATE_BURST=60
# INGEST_MAX_BODY_BYTES=5000000         # compressed request body
# INGEST_MAX_DECOMPRESSED_BYTES=40000000
# INGEST_MAX_FUTURE_SKEW_S=86400        # batches dated further ahead are rejected
# CLOCK_DRIFT_WARN_S=120
# PRESENCE_STALE_AFTER_S=90
# PRESENCE_OFFLINE_AFTER_S=300
# PRIMARY_DEVICE_ID=                    # device shown to clients that do not subscribe
# WS_MAX_SUBSCRIPTIONS=100
# INGEST_MAX_INFLIGHT=32                # concurrent telemetry requests per process before 503 + Retry-After
# INGEST_SHED_REPLAY_ABOVE=0.8          # persistence queue fill above which backlog uploads are deferred
# HOT_STATE_INTERVAL_S=10               # Redis full-twin snapshot per device at most this often
# DEVICE_TOKEN_CACHE_S=300              # verified device tokens cached (ingest survives a DB outage)
# AGGREGATE_RETENTION_DAYS=365          # 5-minute TimescaleDB continuous aggregate
# EVENT_RETENTION_DAYS=365
# RECEIPT_RETENTION_HOURS=168           # durable idempotency window (> agent QUEUE_MAX_AGE_H)
# Agent
# MAX_BATCH_WAIT_MS=5000                # alias PUBLISH_INTERVAL_MS
# MAX_BATCH_SIZE=50                     # alias BATCH_SIZE
# MAX_BATCH_BYTES=1000000
# STATIC_RESEND_S=600
# HEARTBEAT_INTERVAL_S=30
# CRITICAL_TEMPERATURE_C=95
# COLLECTOR_FAILED_AFTER=3

# ---- Phase 7 diagnosis: optional local model (docs/diagnosis.md). Empty DIAGNOSIS_MODELS = rules only ------
# DIAGNOSIS_MODE: LOCAL_ONLY (loopback / host.docker.internal / ollama sidecar) | CENTRAL_PRIVATE | DISABLED
DIAGNOSIS_MODE=LOCAL_ONLY
# Backend in Docker, Ollama on the Windows host:
DIAGNOSIS_LLM_URL=http://host.docker.internal:11434
# Preference order; the first installed model that fits the model host's free memory is used.
DIAGNOSIS_MODELS=
# Device that runs the model: its own telemetry decides whether there is memory to load one
# (a container cannot see the host's memory). Unknown memory = no model.
DIAGNOSIS_MODEL_HOST_DEVICE_ID=
# No inference while the model host's memory use is at or above this percentage.
DIAGNOSIS_MEMORY_GATE_PERCENT=90
# How long Ollama keeps the model loaded after a diagnosis ("0", "30s", "5m"). Short = RAM back quickly.
DIAGNOSIS_MODEL_KEEP_ALIVE=5m
